# Client build output. src/client is the source: TypeScript and SCSS, compiled
# into here by src/build.ts inside the container.
public/

# Snapshots the server writes before API-driven bulk edits. These are local
# recovery material; the parameter tree itself remains versioned.
data/history/

node_modules/

# What the last sync did. Local run state, not catalog data: the page reads it to
# say whether what it is showing came from a run that finished.
data/_last-sync.json
